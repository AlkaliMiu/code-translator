# demo: build explanations in the browser with local rules. http: call VITE_AI_ENDPOINT.
VITE_AI_PROVIDER=demo

# Public backend URL without a trailing slash. Never put an API key in a VITE_ variable.
VITE_AI_ENDPOINT=https://your-worker.example.workers.dev

# Optional request timeout in milliseconds
VITE_AI_TIMEOUT_MS=25000
